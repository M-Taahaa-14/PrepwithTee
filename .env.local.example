# Local development: fully offline, never touches production.
#   copy .env.local.example .env.local
#   .venv\Scripts\python -m uvicorn website.app:app --port 8017 --env-file .env.local
#
# Keys set to empty here are deliberately blank: app.py loads .env afterwards
# but only for keys NOT already present, so an empty value here wins and keeps
# the live credentials out. website/env_guard.py refuses to start if a
# production DB still leaks through.
APP_ENV=local

# Databases -> SQLite (data/index.db for papers, data/users.db for accounts)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# No real email leaves a dev machine
RESEND_API_KEY=
SMTP_USER=
SMTP_PASS=

APP_BASE_URL=http://localhost:8017

# AI keys are inherited from .env so you can try the AI features by hand.
# Blank them here if you want AI calls to fail fast instead of spending credit:
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
