# Caddy gets a TLS certificate automatically on first start, provided the
# domain's A record already points at this server and ports 80 and 443 are
# genuinely reachable (see the iptables note in DEPLOY.md — this is the step
# that catches people out on Oracle Cloud).
#
# Replace prepwithtee.com with your domain, then:
#   sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

# Send www to the apex first. Sign-in cookies are set on whichever host served
# the OAuth callback, and APP_BASE_URL names exactly one host, so serving both
# would leave anyone arriving via www logged out on the apex.
www.prepwithtee.com {
	redir https://prepwithtee.com{uri} permanent
}

:80, prepwithtee.com {
	encode zstd gzip

	# Booklet generation can run for minutes; the default 30s proxy timeout
	# would cut it off and hand the student a 502 halfway through a download.
	# 620s > the 600s subprocess timeout in _run() so Python always fires its
	# own TimeoutExpired (returning a clean 503) before Caddy cuts the wire.
	reverse_proxy 127.0.0.1:8017 {
		transport http {
			read_timeout 620s
			write_timeout 620s
		}
	}

	# Past papers never change once published, so let browsers keep them.
	@archive path /api/library/pdf/*
	header @archive Cache-Control "public, max-age=604800"

	@static path *.css *.js *.png *.jpg *.jpeg *.svg *.woff2 *.webp
	header @static Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Cross-Origin-Opener-Policy same-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	log {
		output file /var/log/caddy/prepwithtee.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
