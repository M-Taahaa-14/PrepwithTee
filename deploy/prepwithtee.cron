# PrepWithTee scheduled jobs.  Install to /etc/cron.d/prepwithtee (mode 644,
# root-owned).  /etc/cron.d entries take a USER column — that is the difference
# from a personal crontab, and omitting it makes cron ignore the whole file.
#
# Times are UTC; the box runs UTC and Pakistan is UTC+5.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# 02:30 UTC = 07:30 PKT — students get the nudge before school.
30 2 * * *  prepwithtee  /srv/prepwithtee/deploy/run-digest.sh >> /var/log/prepwithtee/digest.log 2>&1

# 02:45 UTC = 07:45 PKT — daily lifecycle email triggers (expiries, onboarding, retention).
45 2 * * *  prepwithtee  /srv/prepwithtee/.venv/bin/python -m website.scripts.email_lifecycle >> /var/log/prepwithtee/lifecycle.log 2>&1

# 03:15 UTC = 08:15 PKT — after the digest, before the day's traffic.
15 3 * * *  root  /srv/prepwithtee/deploy/backup.sh >> /var/log/prepwithtee/backup.log 2>&1
