[Unit]
Description=PrepWithTee site
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=prepwithtee
Group=prepwithtee
WorkingDirectory=/srv/prepwithtee
Environment="PATH=/srv/prepwithtee/.venv/bin"
EnvironmentFile=/etc/prepwithtee.env

# Two workers, not three: each booklet build spawns a PyMuPDF subprocess that
# can hold a few hundred MB, and the /api/solve rate limiter counts per worker
# (in-process), so every extra worker multiplies the effective limit.
# website is a package now (auth/users/db use relative imports), so it must be
# imported as website.app from the project root - chdir'ing into website/ and
# loading app:app makes those imports fail at startup.
ExecStart=/srv/prepwithtee/.venv/bin/gunicorn website.app:app \
    --chdir /srv/prepwithtee \
    -k uvicorn.workers.UvicornWorker \
    -w 2 \
    -b 127.0.0.1:8017 \
    --timeout 620 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -

# PDF generation shells out and can legitimately take minutes on a big booklet;
# do not let systemd kill it mid-build.
TimeoutStopSec=60
Restart=always
RestartSec=5

# Basic hardening. The app only ever writes to data/ and /tmp.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/prepwithtee/data

[Install]
WantedBy=multi-user.target
