    {
      "id": "cs-12-straight-lines",
      "bg": "tang",
      "caption": "Coordinate geometry on one card. 📈📌\n\nPerpendicular gradients multiply to −1: flip the fraction and change the sign. Gradient 2/3 → perpendicular −3/2.",
      "hashtags": [
        "olevelmaths",
        "igcsemaths",
        "straightlines",
        "maths",
        "cheatsheet",
        "graphs"
      ],
      "slides": [
        {
          "layout": "formula",
          "eyebrow": "maths · save this 📌",
          "title": "Straight lines",
          "cells": [
            {
              "name": "gradient",
              "f": "m = {y_{2} − y_{1} // x_{2} − x_{1}}"
            },
            {
              "name": "equation",
              "f": "y = mx + c",
              "note": "c = where it crosses the y-axis"
            },
            {
              "name": "midpoint",
              "f": "({x_{1} + x_{2} // 2}, {y_{1} + y_{2} // 2})",
              "wide": true
            },
            {
              "name": "length",
              "f": "√((x_{2} − x_{1})^{2} + (y_{2} − y_{1})^{2})",
              "wide": true
            },
            {
              "name": "parallel",
              "f": "same gradient",
              "words": true
            },
            {
              "name": "perpendicular",
              "f": "m_{1} × m_{2} = −1"
            }
          ]
        }
      ]
