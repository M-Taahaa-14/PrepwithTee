    {
      "id": "cs-01-motion-olevel",
      "bg": "mint",
      "caption": "Motion, on one page. 📌 Save it for your next physics paper.\n\nThe two graph rules (gradient + area) are worth more marks than any single formula. Learn which graph you're looking at first.",
      "hashtags": [
        "olevelphysics",
        "igcsephysics",
        "physics",
        "kinematics",
        "cheatsheet",
        "studytips"
      ],
      "slides": [
        {
          "layout": "formula",
          "eyebrow": "physics · save this 📌",
          "title": "Motion cheat sheet",
          "cells": [
            {
              "name": "speed",
              "f": "v = {d // t}",
              "note": "distance ÷ time"
            },
            {
              "name": "acceleration",
              "f": "a = {v − u // t}",
              "note": "change in velocity ÷ time"
            },
            {
              "name": "resultant force",
              "f": "F = ma",
              "note": "N = kg × m/s²"
            },
            {
              "name": "weight",
              "f": "W = mg",
              "note": "g ≈ 9.8 N/kg on Earth"
            },
            {
              "name": "momentum",
              "f": "p = mv",
              "note": "kg m/s"
            },
            {
              "name": "impulse",
              "f": "FΔt = Δ(mv)",
              "note": "force × time = change in momentum"
            },
            {
              "name": "graph rules",
              "f": "gradient of d–t graph = speed\ngradient of v–t graph = acceleration\narea under v–t graph = distance",
              "wide": true,
              "bg": "lime",
              "words": true
            }
          ],
          "dense": true
        }
      ]
    },
    {
      "id": "cs-02-suvat-alevel",
      "bg": "sky",
      "caption": "The four SUVAT equations, and the one rule people forget: they only work when the acceleration is CONSTANT. 📌\n\nPick the equation that leaves out the letter you don't know and don't need.",
      "hashtags": [
        "alevelphysics",
        "9702",
        "physics",
        "suvat",
        "kinematics",
        "cheatsheet"
      ],
      "slides": [
        {
          "layout": "formula",
          "eyebrow": "a level physics · save this 📌",
          "title": "SUVAT in one slide",
          "cells": [
            {
              "name": "no s",
              "f": "v = u + at"
            },
            {
              "name": "no v",
              "f": "s = ut + {1 // 2}at^{2}"
            },
            {
              "name": "no t",
              "f": "v^{2} = u^{2} + 2as"
            },
            {
              "name": "no a",
              "f": "s = {u + v // 2} t"
            },
            {
              "name": "what the letters mean",
              "f": "s displacement · u initial velocity · v final velocity · a acceleration · t time",
              "wide": true,
              "words": true
            },
            {
              "name": "the catch",
              "f": "constant acceleration only",
              "note": "free fall near Earth: a = g = 9.81 m/s² (down)",
              "wide": true,
              "bg": "sun",
              "words": true
            }
          ]
        }
      ]
    },
