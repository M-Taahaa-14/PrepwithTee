# Staging: a SEPARATE Supabase project with the same schema as production.
# Used for the final pre-deploy check. Create the project in the Supabase
# dashboard, run supabase/schema.sql + website/migrations/*.sql in its SQL
# editor, then fill in the values below.
#   copy .env.staging.example .env.staging
#   .venv\Scripts\python -m uvicorn website.app:app --port 8019 --env-file .env.staging
APP_ENV=staging

DATABASE_URL=postgresql://postgres.<STAGING_REF>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<STAGING_REF>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

RESEND_API_KEY=
SMTP_USER=
SMTP_PASS=

APP_BASE_URL=http://localhost:8019
